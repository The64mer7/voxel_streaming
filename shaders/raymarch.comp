void create_ray(out vec3 ro, out vec3 rd)
{
    ivec2 img_size = imageSize(u_albedo);

    vec2 ndc = (vec2(screen_coords()) + 0.5f) / vec2(img_size) * 2.0f - 1.0f;
    float aspect = float(img_size.x) / float(img_size.y);
    
    vec4 clip = u_inv_proj * vec4(ndc, -1.0f, 1.0f);
    clip /= clip.w;
    vec4 world_pos = u_inv_view * clip;

    ro = u_cam_pos;
    rd = normalize(world_pos.xyz - ro);
}

#define COLOR_OFFSET 0
#define COLOR_BITS 12
#define COLOR_MASK ((1 << COLOR_BITS) - 1)

#define NORMAL_OFFSET 12
#define NORMAL_BITS 12

vec3 unpack_color(uint data)
{
    data &= ((1 << COLOR_BITS) - 1);
    vec3 c;
    c.r = ((data >> 0) & 0xfu) / float(0xfu);
    c.g = ((data >> 4) & 0xfu) / float(0xfu);
    c.b = ((data >> 8) & 0xfu) / float(0xfu);
    return c;

    return vec3
    (
        (data * 195111 + 1499191) % 255,
        (data * 578827 + 7827876) % 255,
        (data * 687786 + 2576785) % 255
    )/255.f;
}

vec3 hash_u1f3(uint v)
{
    vec3 c;
    c.x = v * 14519518 + 19519521;
    c.y = v * 1565851562 + 512156251;
    c.z = v * 495266251 + 154621665;
    return fract(c / 256.f);
}

vec3 unpack_normal(uint packed_normal)
{
    uint quantized_bits = 4;
    uint max_val = (1 << quantized_bits) - 1;

    uvec3 quantized;
    quantized.x = packed_normal & max_val;
    quantized.y = (packed_normal >> quantized_bits) & max_val;
    quantized.z = (packed_normal >> (2 * quantized_bits)) & max_val;

    vec3 normal = vec3(quantized) / float(max_val);
    normal = normal * 2.0f - 1.0f;

    return normalize(normal);
}

vec3 get_normal(uint data)
{
    return unpack_normal((data >> NORMAL_OFFSET) & ((1 << NORMAL_BITS) - 1));
}

ivec4 coord_of_node(uint node_idx)
{
    ivec4 coord = ivec4(0);
    uint shift = 0u;

    while (node_idx != 0xFFFFFFFFu)
    {
        uint parent_idx = nodes.node_buffer[node_idx].parent;

        if (parent_idx == 0xFFFFFFFFu)
            return coord;

        uint parent_first_child = nodes.node_buffer[parent_idx].child_index;
        uint dense_offset = node_idx - parent_first_child;

        uint mask0 = nodes.node_buffer[parent_idx].child_mask0;
        uint mask1 = nodes.node_buffer[parent_idx].child_mask1;

        uint target_bit_index = 0u;

        // Iterate through the 64-bit childmask (mask0 = low 32 bits, mask1 = high 32 bits)
        // to find the set bit corresponding to the dense_offset-th child.
        for (uint i = 0u; i <= dense_offset; ++i)
        {
            if (mask0 != 0u)
            {
                uint bit_idx = uint(findLSB(mask0));
                if (i == dense_offset)
                {
                    target_bit_index = bit_idx;
                    break;
                }
                mask0 &= ~(1u << bit_idx);
            }
            else if (mask1 != 0u)
            {
                uint bit_idx = 32u + uint(findLSB(mask1));
                if (i == dense_offset)
                {
                    target_bit_index = bit_idx;
                    break;
                }
                mask1 &= ~(1u << (bit_idx - 32u));
            }
            else
            {
                break; // No more set bits available
            }
        }

        coord.x |= int(((target_bit_index / 1u) % 4u) << shift);
        coord.y |= int(((target_bit_index / 4u) % 4u) << shift);
        coord.z |= int(((target_bit_index / 16u) % 4u) << shift);
        coord.w++;
        shift += 2u;

        node_idx = parent_idx;
    }
    return coord;
}

float projected_voxel_size(float depth, float voxel_size)
{
    float focal_length = 1 / u_inv_proj[1][1];
    float voxel_half_size = voxel_size * 0.5f;
    float projected = voxel_half_size * focal_length / depth;
    return projected;
}

uint get_expected_lod(float dist)
{
    float radius = 64.f;
    float segments = max(1.f, dist / radius);
    float flod = max(0.f, 4.f - log2(segments));

    return uint(floor(flod));
}

void main()
{
    ivec2 img_size = ivec2(imageSize(u_albedo));
    if (any(greaterThanEqual(screen_coords(), img_size)))
        return;

    uint thread_idx = gl_LocalInvocationIndex;
    if (thread_idx == 0)
        s_requests_counter = 0;
    barrier();
    
    vec3 ro;
    vec3 rd;
    create_ray(ro, rd);
    raymarch_hit hit = raymarch_tree(u_chunk_size, ro, rd);
    
    vec3 albedo = vec3(0.f);
    vec3 normal = vec3(0.f);
    if (hit.t >= -0.5f)
    {
        albedo = unpack_color(hit.data);
        normal = get_normal(hit.data);
    }
    
    //write_albedo(vec3(hit.iteration_count / float(MAX_ITERATIONS)));
    write_albedo(albedo);
    write_depth(hit.t);
    write_normal(vec4(normal, 1.f));

    barrier();
    if (hit.t >= -0.5f)
    {
        request_node(hit.node_idx, 7u - hit.depth);
        request_node_to_temp(hit.node_idx);
    }
    request_nodes_to_img();
    if (thread_idx == 0 && s_requests_counter > 0)
    {
        uint old_count = atomicAdd(request_count, s_requests_counter);
        if (old_count < request_buffer.length())
        {
            s_base_index = old_count;
        }
        else 
        {
            atomicAdd(request_count, -s_requests_counter);
            s_base_index = INVALID_OFFSET;
        }
    }
    barrier();
    if (s_base_index != INVALID_OFFSET && s_requests_counter > 0)
    {
        if (thread_idx < s_requests_counter)
        {
            uint target_idx = s_base_index + thread_idx;
            if (target_idx < request_buffer.length())
                request_buffer[target_idx] = s_requests[thread_idx];
        }
    }
}


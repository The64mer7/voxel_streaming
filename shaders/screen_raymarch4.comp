#version 460 core

layout(local_size_x = 16, local_size_y = 16) in;

uniform sampler2D u_hzb;
uniform sampler2D u_normal;
uniform sampler2D u_albedo;
uniform mat4 u_proj;
uniform mat4 u_inv_proj;
uniform mat4 u_view;
uniform mat4 u_inv_view;
uniform mat4 u_prev_viewproj;

uniform vec3 u_cam_pos;
uniform uint u_frame_index;
uniform float u_hysteresis;
uniform float u_radius;



layout(rgba16f, binding = 0) uniform image2D u_indirect;
layout(rgba16f, binding = 1) uniform image2D u_debug_texture;
uniform sampler2D u_prev_indirect_texture;

const int MAX_TRAVERSAL_STEPS = 64;
const float MAX_RAY_DISTANCE = 64.0;
const float SURFACE_BIAS = 0.05;
const float STEP_BIAS = 1e-3;

struct raymarch_hit
{
    bool hit;
    vec3 pos;
    vec2 uv;
    int it;
    float t;
};

vec4 world_to_clip(vec3 world_pos)
{
    return u_proj * u_view * vec4(world_pos, 1.0);
}

vec4 world_ray_to_clip(vec3 world_ray)
{
    return u_proj * u_view * vec4(world_ray, 0.0);
}

bool world_to_screen(vec3 world_pos, out vec3 screen_pos, out vec4 clip)
{
    clip = world_to_clip(world_pos);
    if (clip.w <= 1e-8)
        return false;

    vec2 uv = clip.xy / clip.w * 0.5 + 0.5;
    screen_pos = vec3(uv, length(world_pos - u_cam_pos));
    return all(greaterThanEqual(uv, vec2(0.0))) &&
           all(lessThan(uv, vec2(1.0)));
}

vec3 world_ray_to_screen(vec3 world_pos, vec3 world_ray)
{
    vec4 clip = world_to_clip(world_pos);
    vec4 clip_ray = world_ray_to_clip(world_ray);
    float inv_w_squared = 1.0 / (clip.w * clip.w);
    vec2 uv_rate = 0.5 *
        (clip_ray.xy * clip.w - clip.xy * clip_ray.w) * inv_w_squared;
    vec3 to_camera = world_pos - u_cam_pos;
    float radial_depth_rate = dot(to_camera, world_ray) /
                              max(length(to_camera), 1e-8);
    return vec3(uv_rate, radial_depth_rate);
}

bool in_range(float value, vec2 range)
{
    return value >= range.x && value <= range.y;
}

float distance_to_next_cell(
    vec4 clip,
    vec4 clip_ray,
    vec2 uv,
    vec2 uv_rate,
    int lod,
    float max_distance)
{
    ivec2 cell_count = textureSize(u_hzb, lod);
    ivec2 cell = ivec2(floor(uv * vec2(cell_count)));
    float nearest_distance = max_distance;

    for (int axis = 0; axis < 2; ++axis)
    {
        float clip_position = axis == 0 ? clip.x : clip.y;
        float clip_velocity = axis == 0 ? clip_ray.x : clip_ray.y;
        if (abs(uv_rate[axis]) < 1e-8)
            continue;

        float direction = sign(uv_rate[axis]);
        float boundary_uv = (float(cell[axis]) +
                             (direction > 0.0 ? 1.0 : 0.0)) /
                            float(cell_count[axis]);
        float boundary_ndc = boundary_uv * 2.0 - 1.0;
        float denominator = clip_velocity - boundary_ndc * clip_ray.w;
        if (abs(denominator) < 1e-8)
            continue;

        float distance = (boundary_ndc * clip.w - clip_position) / denominator;
        if (distance > STEP_BIAS)
            nearest_distance = min(nearest_distance, distance);
    }

    return nearest_distance;
}

bool next_radial_interval_entry(
    vec3 ray_origin,
    vec3 ray_direction,
    float current_t,
    float max_t,
    vec2 radial_range,
    out float entry_t)
{
    vec3 offset = ray_origin - u_cam_pos;
    float half_b = dot(offset, ray_direction);
    float c = dot(offset, offset);
    float nearest_t = current_t + max_t + 1.0;

    for (int bound_index = 0; bound_index < 2; ++bound_index)
    {
        float radius = bound_index == 0 ? radial_range.x : radial_range.y;
        if (radius < 0.0)
            continue;

        float discriminant = half_b * half_b - (c - radius * radius);
        if (discriminant < 0.0)
            continue;

        float root = sqrt(discriminant);
        for (int root_index = 0; root_index < 2; ++root_index)
        {
            float candidate_t = -half_b + (root_index == 0 ? -root : root);
            if (candidate_t <= current_t + STEP_BIAS ||
                candidate_t > current_t + max_t ||
                candidate_t >= nearest_t)
                continue;

            float candidate_depth = length(
                offset + ray_direction * candidate_t);
            if (in_range(candidate_depth, radial_range))
                nearest_t = candidate_t;
        }
    }

    if (nearest_t <= current_t + max_t)
    {
        entry_t = nearest_t;
        return true;
    }
    return false;
}

raymarch_hit raymarch_depth_buffer(vec3 world_pos, vec3 world_ray)
{
    raymarch_hit hit;
    hit.hit = false;
    hit.pos = vec3(0.0);
    hit.uv = vec2(0.0);
    hit.it = 0;
    hit.t = 0.0;

    vec3 ray_direction = normalize(world_ray);
    vec4 clip_ray = world_ray_to_clip(ray_direction);
    int max_lod = textureQueryLevels(u_hzb) - 1;
    int lod = max_lod;
    float t = 0.0;

    for (int iteration = 0; iteration < MAX_TRAVERSAL_STEPS; ++iteration)
    {
        hit.it = iteration;
        float remaining_distance = MAX_RAY_DISTANCE - t;
        if (remaining_distance <= 0.0)
            break;

        vec3 ray_pos = world_pos + ray_direction * t;
        vec3 screen_pos;
        vec4 clip;
        if (!world_to_screen(ray_pos, screen_pos, clip))
            break;

        vec3 screen_ray = world_ray_to_screen(ray_pos, ray_direction);
        ivec2 cell_count = textureSize(u_hzb, lod);
        ivec2 cell = clamp(
            ivec2(floor(screen_pos.xy * vec2(cell_count))),
            ivec2(0),
            cell_count - 1
        );
        vec2 radial_range = texelFetch(u_hzb, cell, lod).xy;

        if (radial_range.y > 0.0 &&
            in_range(screen_pos.z, radial_range))
        {
            if (lod == 0)
            {
                hit.hit = true;
                hit.pos = ray_pos;
                hit.uv = screen_pos.xy;
                hit.t = t;
                return hit;
            }

            --lod;
            continue;
        }

        float cell_distance = distance_to_next_cell(
            clip, clip_ray, screen_pos.xy, screen_ray.xy, lod, remaining_distance);
        float step_distance = cell_distance;
        float interval_entry_t;
        if (radial_range.y > 0.0 &&
            next_radial_interval_entry(
                world_pos, ray_direction, t, cell_distance,
                radial_range, interval_entry_t))
        {
            step_distance = min(step_distance, interval_entry_t - t);
        }

        if (step_distance <= STEP_BIAS)
        {
            t += STEP_BIAS;
            continue;
        }

        t += step_distance + STEP_BIAS;
        if (step_distance >= cell_distance - STEP_BIAS && lod < max_lod)
            ++lod;
    }

    return hit;
}

void create_ray(out vec3 ray_origin, out vec3 ray_direction, ivec2 pixel, ivec2 image_size)
{
    vec2 ndc = (vec2(pixel) + 0.5) / vec2(image_size) * 2.0 - 1.0;
    vec4 clip = u_inv_proj * vec4(ndc, -1.0, 1.0);
    clip /= clip.w;
    vec4 world_pos = u_inv_view * clip;

    ray_origin = u_cam_pos;
    ray_direction = normalize(world_pos.xyz - ray_origin);
}

vec3 get_flat_normal(ivec2 pixel)
{
    uint packed_normal = uint(round(texelFetch(u_normal, pixel, 0).w * 64.0));
    return vec3(
        float((packed_normal >> 0) & 3u) - 1.0,
        float((packed_normal >> 2) & 3u) - 1.0,
        float((packed_normal >> 4) & 3u) - 1.0
    );
}

uint hash_u1(uint v)
{
    v ^= v >> 16u;
    v *= 0x7feb352du;
    v ^= v >> 15u;
    v *= 0x846ca68bu;
    v ^= v >> 16u;
    return v;
}

vec3 random_hemisphere_direction(vec3 normal, uint seed)
{
    float u1 = float(hash_u1(seed) >> 8u) * (1.0 / 16777216.0);
    float u2 = float(hash_u1(seed ^ 0x9e3779b9u) >> 8u) * (1.0 / 16777216.0);

    float radius = sqrt(u1);
    float angle = 6.28318530718 * u2;
    vec3 local_dir = vec3(
        radius * cos(angle),
        radius * sin(angle),
        sqrt(max(0.0, 1.0 - u1))
    );

    vec3 reference = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0)
                                           : vec3(0.0, 1.0, 0.0);
    vec3 tangent = normalize(cross(reference, normal));
    vec3 bitangent = cross(normal, tangent);
    return normalize(tangent * local_dir.x +
                     bitangent * local_dir.y +
                     normal * local_dir.z);
}

float sample_shadow_factor(vec3 wp)
{
    return 1.f;
}

vec3 sun_dir()
{
    return normalize(vec3(1.0, -1.0, 1.0));
}

vec3 sample_direct_light(vec3 wp, vec3 normal)
{
    vec3 sun_color = vec3(200, 182, 150)/255.f;
    float sun_intensity = 2.f;
    float n_dot_l = max(dot(normal, -sun_dir()), 0.f);

    return sun_intensity * sun_color * n_dot_l * sample_shadow_factor(wp);
}

vec2 get_prev_uv(vec3 surface_wp)
{
    vec4 prev_clip = u_prev_viewproj * vec4(surface_wp, 1.f);

    vec2 prev_ndc = prev_clip.xy / prev_clip.w;

    return clamp(prev_ndc * 0.5f + 0.5f,vec2(0),vec2(0.9999));
}

vec3 sample_skybox(vec3 ray_direction)
{
    float t = clamp(ray_direction.y * 0.5 + 0.5, 0.0, 1.0);
    
    vec3 horizon_color = vec3(1.0, 0.55, 0.2);
    vec3 zenith_color = vec3(0.25, 0.5, 0.9);
    vec3 sky = mix(horizon_color, zenith_color, t);

    vec3 sun_color = vec3(1.0, 0.85, 0.55) * 10.0;
    float sun = smoothstep(0.9995, 0.9998, dot(ray_direction, -sun_dir()));

    return sky + sun_color * sun;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 image_size = textureSize(u_hzb, 0);
    if (any(greaterThanEqual(pixel, image_size)))
        return;

    float depth = texelFetch(u_hzb, pixel, 0).x;
    vec3 normal = get_flat_normal(pixel);
    if (depth < 0.0 || dot(normal, normal) < 0.5)
    {
        imageStore(u_indirect, pixel, vec4(0.0));
        return;
    }

    vec3 ray_origin;
    vec3 view_ray;
    create_ray(ray_origin, view_ray, pixel, image_size);
    normal = normalize(normal);

    ivec2 seed_pixel = pixel * 2651 + int(u_frame_index) * 611191;

    uint seed = uint(seed_pixel.x) +
                uint(seed_pixel.y) * uint(textureSize(u_albedo, 0).x);


    vec3 reflected = random_hemisphere_direction(normal, seed);
    vec3 world_pos = ray_origin + view_ray * depth;
    vec3 trace_origin = world_pos + normal * SURFACE_BIAS;
    raymarch_hit hit = raymarch_depth_buffer(trace_origin, reflected);

    vec4 indirect = vec4(0);

    float emissive = 0.0;
    if (hit.hit)
    {
        ivec2 albedo_size = textureSize(u_albedo, 0);
        
        vec2 prev_hit_uv = get_prev_uv(hit.pos);
        vec3 hit_albedo = texture(u_albedo, hit.uv).rgb;

        vec4 hit_indirect = texture(u_prev_indirect_texture, prev_hit_uv);

        ivec2 debug_size = imageSize(u_debug_texture);
        ivec2 debug_pixel = clamp(
            ivec2(hit.uv * vec2(debug_size)),
            ivec2(0),
            debug_size - 1
        );

        emissive = imageLoad(u_debug_texture, debug_pixel).b;
        float dist_sq = hit.t * hit.t;
        float attenuation = 128.f / max(dist_sq, 1.f);

        vec3 emissive_radiance = hit_albedo * emissive * attenuation;
        indirect.rgb = hit_albedo * hit_indirect.rgb + emissive_radiance;
        indirect.a = hit_indirect.a * min(hit.t / u_radius, 1.f);
    }
    else
    {
        indirect.rgb = sample_skybox(reflected);
        indirect.a = 1.f;
    }

    vec2 prev_uv = get_prev_uv(world_pos);
    vec4 prev_indirect = texture(u_prev_indirect_texture, prev_uv);

    vec4 debug = imageLoad(u_debug_texture, pixel);

    debug.r = float(hit.it) / float(MAX_TRAVERSAL_STEPS);
    indirect = mix(indirect, prev_indirect, u_hysteresis);

    imageStore(u_indirect, pixel, indirect);
    imageStore(u_debug_texture, pixel, debug);
}

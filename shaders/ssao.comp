#version 460 core 

layout (local_size_x = 16, local_size_y = 16) in;

layout (r16f, binding = 0) uniform image2D u_ao;

uniform sampler2D u_depth;
uniform sampler2D u_debug_texture;
uniform mat4 u_inv_view;
uniform mat4 u_inv_proj;
uniform mat4 u_view;
uniform mat4 u_proj;
uniform vec3 u_cam_pos;

uniform float u_radius;
uniform float u_bias;

void create_ray(ivec2 uvi, out vec3 ro, out vec3 rd)
{
    ivec2 img_size = textureSize(u_depth, 0);
    
    vec2 ndc = (vec2(uvi) + 0.5f) / vec2(img_size) * 2.0f - 1.0f;
    
    vec4 clip = u_inv_proj * vec4(ndc, -1.0f, 1.0f);
    clip /= clip.w;
    vec4 world_pos = u_inv_view * clip;

    ro = u_cam_pos;
    rd = normalize(world_pos.xyz - ro);
}

vec3 hemisphere_dir(vec3 normal, int i)
{
    const float sample_count = 8.0f;
    const float golden_angle = 2.39996323f;

    if (dot(normal, normal) < 0.5f)
        return vec3(0.0f);

    normal = normalize(normal);

    float z = (float(i) + 0.5f) / sample_count;
    float radius = sqrt(max(0.0f, 1.0f - z * z));
    float angle = float(i) * golden_angle;
    vec3 local_dir = vec3(radius * cos(angle), radius * sin(angle), z);

    vec3 reference = abs(normal.z) < 0.999f ? vec3(0.0f, 0.0f, 1.0f)
                                             : vec3(0.0f, 1.0f, 0.0f);
    vec3 tangent = normalize(cross(reference, normal));
    vec3 bitangent = cross(normal, tangent);

    return normalize(tangent * local_dir.x +
                     bitangent * local_dir.y +
                     normal * local_dir.z);
}

void main()
{
    ivec2 iuv = ivec2(gl_GlobalInvocationID.xy);
    ivec2 img_size = imageSize(u_ao);

    if (any(greaterThanEqual(iuv, img_size)))
        return;

    ivec2 source_size = textureSize(u_depth, 0);
    ivec2 source_uv = min(
        ivec2((vec2(iuv) + 0.5f) * vec2(source_size) / vec2(img_size)),
        source_size - 1
    );

    float depth = texelFetch(u_depth, source_uv, 0).x;
    if (depth < 0.0f)
    {
        imageStore(u_ao, iuv, vec4(1.0f, 0.0f, 0.0f, 0.0f));
        return;
    }

    vec4 debug = texelFetch(u_debug_texture, source_uv, 0);
    uint packed_normal = uint(round(debug.w));

    vec3 normal;
    normal.x = float(((packed_normal >> 0) & 3u)) - 1.f;
    normal.y = float(((packed_normal >> 2) & 3u)) - 1.f;
    normal.z = float(((packed_normal >> 4) & 3u)) - 1.f;

    if (dot(normal, normal) < 0.5f)
    {
        imageStore(u_ao, iuv, vec4(1.0f, 0.0f, 0.0f, 0.0f));
        return;
    }

    float occulusion = 0.f;

    vec3 ro;
    vec3 rd;
    create_ray(source_uv, ro, rd);

    vec3 ao_ro = ro + rd * depth;
    for(int i = 0; i < 8; i++)
    {
        vec3 ao_rd = hemisphere_dir(normal, i)/(normal * 5);
        ao_rd = normalize(ao_rd);
        vec3 ao_end = ao_ro + ao_rd * u_radius;

        vec4 ao_end_homogeneous = vec4(ao_end, 1.f);
        vec4 ao_end_clip = u_proj * u_view * ao_end_homogeneous;
        if (ao_end_clip.w <= 0.0f)
            continue;

        vec3 ndc = ao_end_clip.xyz / ao_end_clip.w;
        if (any(greaterThan(abs(ndc), vec3(1.0f))))
            continue;

        vec2 uv = ndc.xy * 0.5f + 0.5f;
        
        float world_depth = distance(ao_end, u_cam_pos);
        float sampled_depth = texture(u_depth, uv).x;
        if (sampled_depth >= 0.f && sampled_depth < world_depth - u_bias)
        {
            occulusion += 1/8.f;
        }
    }

    float ao = 1.f - occulusion;
    imageStore(u_ao, iuv, vec4(ao, 0, 0, 0));
}
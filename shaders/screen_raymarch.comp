#version 460 core 

layout (local_size_x = 16, local_size_y = 16) in;

uniform sampler2D u_hzb;
uniform sampler2D u_normal;
uniform sampler2D u_albedo;
uniform mat4 u_proj;
uniform mat4 u_inv_proj;
uniform mat4 u_view;
uniform mat4 u_inv_view;
uniform vec3 u_cam_pos;
uniform uint u_frame_index;
uniform float u_hysteresis;

uniform float u_radius;

layout(rgba16f, binding = 0) uniform image2D u_indirect;
layout(rgba16f, binding = 1) uniform image2D u_debug_texture;

struct raymarch_hit
{
    bool hit;
    vec3 pos;
    int it;
};

ivec2 texels_count_at_lod(int lod)
{
    return textureSize(u_hzb, lod);
}

vec2 texel_size_at_lod(int lod)
{
    return 1.f / texels_count_at_lod(lod);
}

vec2 fetch_depthf(vec2 uv, int lod)
{
    //vec2 minmax = textureLod(u_hzb, uv, lod).xy;
    vec2 minmax = texelFetch(u_hzb, ivec2(uv * vec2(texels_count_at_lod(lod))), lod).xy;
    return minmax;
}

vec3 get_safe_ird(vec3 rd)
{
    vec3 safe_sign = mix(vec3(-1.0), vec3(1.0), greaterThanEqual(rd, vec3(0.0)));
    vec3 safe_abs_rd = max(vec3(1e-5), abs(rd));
    return safe_sign / safe_abs_rd;
}

bool in_range(vec2 uv, vec2 minmax)
{
    return all(greaterThanEqual(uv, minmax.xx)) && all(lessThan(uv, minmax.yy));
}

bool in_range(float u, vec2 minmax)
{
    return u >= minmax.x && u < minmax.y;
}

vec2 quantize_uv(vec2 uv, int lod)
{
    vec2 texel_size = texel_size_at_lod(lod);
    return floor(uv / texel_size) * texel_size;
}

float compMin(vec3 v) { return min(v.x, min(v.y, v.z)); }
float compMin(vec2 v) { return min(v.x, v.y); }

raymarch_hit raymarch_depth_buffer(vec3 pos, vec3 rd)
{
    // TODO: convert pos.xy to uv, rd.xy to UV/dUV -> unitless, pos.z to ndc, rd.z to NDC/dUV
    // side_dist = (cell_pos.xy - pos.xy)/rd.xy = (uv - uv) / unitless = duv
    // side_dist = (cell_pos.z - pos.z)/rd.z = (ndc - ndc) / ndc / duv = dndc/ndc/duv = duv * dndc / ndc = duv
    // same units, side_dist is correct (hzb must be ndc)


    raymarch_hit hit;
    hit.hit = false;
    int max_lod = textureQueryLevels(u_hzb) - 1;
    int lod = max_lod;

    vec3 ird = get_safe_ird(rd);
    vec3 srd = sign(ird);
    vec3 pos_rd = step(vec3(0), ird);
    vec2 scene_minmax = fetch_depthf(pos.xy, lod);

    for (int i = 0; i < 64; i++)
    {
        hit.it = i;
        vec2 minmax = fetch_depthf(pos.xy, lod);
        vec2 quantized_uv = quantize_uv(pos.xy, lod);
        vec2 cell_size = texel_size_at_lod(lod);
        if (!in_range(pos.xy, vec2(0, 1)) || !in_range(pos.z, scene_minmax))
        {
            hit.hit = false;
            break;
        }
        if (in_range(pos.z, minmax)) // inside cell, must descend
        {
            if (lod <= 0)
            {
                hit.hit = true;
                hit.pos = pos;
                break;
            }
            lod--;
            continue;
        }

        // check closest cell
        vec3 cell_pos;
        cell_pos.xy = quantized_uv + cell_size * pos_rd.xy;
        cell_pos.z = rd.z > 0 ? minmax.x : minmax.y;

        vec3 side_dist = (cell_pos - pos) * ird;
        float mindist = compMin(side_dist);
        if (side_dist.z < 0)
        {
            mindist = compMin(side_dist.xy);
        }
        bool is_horizontal_hit = mindist != side_dist.z;

        if (is_horizontal_hit) // hit horizontally
        {
            if (lod == max_lod)
            {
                hit.hit = false;
                break;
            }
            lod++;
        }
        else // hit vertically
        {
            if (rd.z <= 0)
            {
                hit.hit = false;
                break;
            }
            if (lod <= 0)
            {
                hit.hit = true;
                pos = pos + rd * (mindist + 0.001f);
                hit.pos = pos;
                break;
            }
        }

        pos = pos + rd * (mindist + 0.001f);
    }
    return hit;
}

void create_ray(out vec3 ro, out vec3 rd, ivec2 uvi, ivec2 img_size)
{
    vec2 ndc = (vec2(uvi) + 0.5f) / vec2(img_size) * 2.0f - 1.0f;
    float aspect = float(img_size.x) / float(img_size.y);
    
    vec4 clip = u_inv_proj * vec4(ndc, -1.0f, 1.0f);
    clip /= clip.w;
    vec4 world_pos = u_inv_view * clip;

    ro = u_cam_pos;
    rd = normalize(world_pos.xyz - ro);
}

vec3 to_screen(
    vec3 world_pos,
    vec3 reflected,
    float step_length)
{
    vec3 next_pos = world_pos + normalize(reflected) * step_length;

    vec4 clip0 = u_proj * u_view * vec4(world_pos, 1.0);
    vec4 clip1 = u_proj * u_view * vec4(next_pos, 1.0);

    vec2 uv0 = clip0.xy / clip0.w * 0.5 + 0.5;
    vec2 uv1 = clip1.xy / clip1.w * 0.5 + 0.5;

    float depth0 = length(world_pos - u_cam_pos);
    float depth1 = length(next_pos - u_cam_pos);

    return vec3(uv1 - uv0, depth1 - depth0) / step_length;
}

vec3 get_flat_normal(ivec2 uvi)
{
    float flat_normal = texelFetch(u_normal, uvi, 0).w;
    uint packed_normal = uint(round(flat_normal * 64.f));
    vec3 normal;

    normal.x = float(((packed_normal >> 0) & 3u)) - 1.f;
    normal.y = float(((packed_normal >> 2) & 3u)) - 1.f;
    normal.z = float(((packed_normal >> 4) & 3u)) - 1.f;
    return normal;
}
uint hash_u1(uint v)
{
    v ^= v >> 16u;
    v *= 0x7feb352du;
    v ^= v >> 15u;
    v *= 0x846ca68bu;
    v ^= v >> 16u;
    return v;
}
vec3 random_hemisphere_direction(vec3 normal, uint seed)
{
    float u1 = float(hash_u1(seed) >> 8u) * (1.0f / 16777216.0f);
    float u2 = float(hash_u1(seed ^ 0x9e3779b9u) >> 8u) * (1.0f / 16777216.0f);

    float radius = sqrt(u1);
    float angle = 6.28318530718f * u2;
    vec3 local_dir = vec3(
        radius * cos(angle),
        radius * sin(angle),
        sqrt(max(0.0f, 1.0f - u1))
    );

    vec3 reference = abs(normal.z) < 0.999f ? vec3(0.0f, 0.0f, 1.0f)
                                             : vec3(0.0f, 1.0f, 0.0f);
    vec3 tangent = normalize(cross(reference, normal));
    vec3 bitangent = cross(normal, tangent);

    return normalize(tangent * local_dir.x +
                     bitangent * local_dir.y +
                     normal * local_dir.z);
}

vec3 sun_dir()
{
    return normalize(vec3(1,-1,1));
}
vec3 sample_skybox(vec3 rd)
{
    float t = clamp(rd.y * 0.5 + 0.5, 0.0, 1.0);

    vec3 horizon_color = vec3(1.0, 0.55, 0.2);
    vec3 zenith_color = vec3(0.25, 0.5, 0.9);
    vec3 sky = mix(horizon_color, zenith_color, t);

    vec3 sun_color = vec3(1.0, 0.85, 0.55) * 10.0;
    float sun = smoothstep(0.9995, 0.9998, dot(rd, -sun_dir()));

    return sky + sun_color * sun;
}

void main()
{
    ivec2 uvi = ivec2(gl_GlobalInvocationID.xy);
    ivec2 tex_size = textureSize(u_hzb, 0);
    if (any(greaterThanEqual(uvi, tex_size)))
        return;

    vec3 ro;
    vec3 rd;
    create_ray(ro, rd, uvi, tex_size);
    vec3 normal = get_flat_normal(uvi);
    ivec2 pixel = uvi * 2651 + int(u_frame_index)*611191;
    uint seed = uint(pixel.x) + uint(pixel.y) * uint(textureSize(u_albedo, 0).x);

    vec3 ao_rd = random_hemisphere_direction(normal, seed);

    vec3 reflected = ao_rd;
    //reflected = reflect(rd, normal);
    float depth = texelFetch(u_hzb, uvi, 0).x;

    vec3 wp = ro + rd * depth;
    vec3 screen_reflected = to_screen(wp, reflected, 1.f);

    vec2 uv = (vec2(uvi) + 0.5) / vec2(tex_size);
    vec3 trace_ro = vec3(uv, depth - 0.5f);
    raymarch_hit hit = raymarch_depth_buffer(trace_ro, screen_reflected);
    vec3 indirect = vec3(0);
    float emissive = 0.f;
    if (hit.hit)
    {
        indirect = texture(u_albedo, hit.pos.xy).rgb;
        emissive = imageLoad(u_debug_texture, ivec2(hit.pos.xy * tex_size)).b;
    }
    else
    {
        indirect = sample_skybox(reflected);
    }

    vec3 prev_indirect = imageLoad(u_indirect, uvi).rgb;
    vec4 debug = imageLoad(u_debug_texture, uvi);
    float prev_ao = debug.a;
    indirect = mix((1 + 16 * emissive) * indirect, prev_indirect, u_hysteresis);
    float ao = min(length((trace_ro - hit.pos) / vec3(1,1,1)) / u_radius, 1.f);
    float new_ao = mix(ao, prev_ao, u_hysteresis);
    
    debug.a = new_ao;

    imageStore(u_indirect, uvi, vec4(indirect, 1.0));
    imageStore(u_debug_texture, uvi, debug);
}
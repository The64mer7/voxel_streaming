#version 460 core 
layout(local_size_x = 16, local_size_y = 16) in;

struct Probe
{
    vec3 indirect;
    float depth_moment;
    vec3 last_ray_dir;
    float depth_moment_sq;
};

layout(std430, binding = 0) buffer IrradianceProbes
{
    Probe probes[];
} probes;


layout(rgba8, binding = 0) uniform image2D u_albedo;
layout(r16f, binding = 1) uniform image2D u_depth;
layout(rgba16_snorm, binding = 2) uniform image2D u_normal;

layout(rg16f, binding = 3) uniform image2DArray u_probe_depths;
layout(rgba8, binding = 4) uniform image2DArray u_probe_colors;
uniform sampler2DArray u_probe_depths_tex;
uniform sampler2DArray u_probe_colors_tex;

uniform sampler2D u_debug_texture;
uniform sampler2D u_ao;

layout(rgba8, binding = 3) uniform image2D u_final;

uniform uint u_display_texture;
uniform vec3 u_cam_pos;
uniform mat4 u_inv_proj;
uniform mat4 u_inv_view;
uniform float u_brightness;
uniform float u_probe_spacing;
uniform uvec3 u_probe_counts;
uniform int u_probe_resolution;

// octahedral mapping functions from: https://gist.github.com/pyalot/cc7c3e5f144fb825d626
#define sectorize(value) step(0.0, (value))*2.0-1.0
#define sum(value) dot(clamp((value), 1.0, 1.0), (value))

vec2 normalToUvRectOct(vec3 normal)
{
    normal /= sum(abs(normal));
    if(normal.y > 0.0){
        return normal.xz*0.5+0.5;
    }
    else{
        vec2 suv = sectorize(normal.xz);
        vec2 uv = suv-suv*abs(normal.zx);
        return uv*0.5+0.5;
    }
}

vec3 uvToNormalRectOct(vec2 uv)
{
    uv = uv*2.0-1.0;
    vec2 auv = abs(uv);
    vec2 suv = sectorize(uv);
    float l = sum(auv);

    if(l > 1.0){
        uv = (1.0-auv.ts)*suv;
    }

    return normalize(vec3(uv.s,1.0-l,uv.t));
}

ivec2 screen_coords()
{
    return ivec2(gl_GlobalInvocationID.xy);
}

void create_ray(ivec2 uvi, out vec3 ro, out vec3 rd)
{
    ivec2 img_size = imageSize(u_albedo);

    vec2 ndc = (vec2(uvi) + 0.5f) / vec2(img_size) * 2.0f - 1.0f;
    float aspect = float(img_size.x) / float(img_size.y);
    
    vec4 clip = u_inv_proj * vec4(ndc, -1.0f, 1.0f);
    clip /= clip.w;
    vec4 world_pos = u_inv_view * clip;

    ro = u_cam_pos;
    rd = normalize(world_pos.xyz - ro);
}

#define DISPLAY_FINAL 0
#define DISPLAY_ALBEDO 1
#define DISPLAY_DEPTH 2
#define DISPLAY_NORMAL 3
#define DISPLAY_INDIRECT 4
#define DISPLAY_SUBDIV_DEPTH 5
#define DISPLAY_ITERATIONS 6
#define DISPLAY_PROBE_DEPTH 7
#define DISPLAY_PROBE_COLOR 8
#define DISPLAY_AO 9

vec3 trilinear_interpolate(
    vec3 c000, vec3 c100, vec3 c010, vec3 c110,
    vec3 c001, vec3 c101, vec3 c011, vec3 c111,
    vec3 f
)
{
    vec3 x00 = mix(c000, c100, f.x);
    vec3 x10 = mix(c010, c110, f.x);
    vec3 x01 = mix(c001, c101, f.x);
    vec3 x11 = mix(c011, c111, f.x);

    vec3 y0 = mix(x00, x10, f.y);
    vec3 y1 = mix(x01, x11, f.y);

    return mix(y0, y1, f.z);
}

vec3 trilinear_interpolate(
    vec3 c[8],
    float w[8],
    vec3 f
)
{
    for (int i = 0; i < 8; i++)
        c[i] *= w[i];

    vec3 x00 = mix(c[0], c[1], f.x);
    vec3 x10 = mix(c[2], c[3], f.x);
    vec3 x01 = mix(c[4], c[5], f.x);
    vec3 x11 = mix(c[6], c[7], f.x);

    vec3 y0 = mix(x00, x10, f.y);
    vec3 y1 = mix(x01, x11, f.y);

    return mix(y0, y1, f.z);
}

uint flatten_index(ivec3 c, int axis_branching_factor)
{
    return uint(c.x + c.y * axis_branching_factor + c.z * axis_branching_factor * axis_branching_factor);
}

ivec3 coord_from_world(vec3 wp, float size) 
{ 
    return ivec3(floor(wp / size)); 
}

float get_depth_moment(Probe probe, vec3 n)
{
    return probe.depth_moment;
}

float get_depth_moment_sq(Probe probe, vec3 n)
{
    return probe.depth_moment_sq;
}

float get_variance(float x, float x_sq)
{
    return x_sq - x*x;
}

vec2 uv_to_atlas_uv(vec2 uv_norm, vec2 atlas_offset, vec2 atlas_size)
{
    vec2 uv = (uv_norm + atlas_offset) / atlas_size;
    return uv;
}


void read_probe_data(ivec3 probe_coord, vec3 normal, out vec2 moments, out vec3 indirect)
{
    vec2 uv = normalToUvRectOct(normal);
    
    ivec2 local_iuv = ivec2(uv * float(u_probe_resolution));
    ivec2 global_iuv = ivec2(probe_coord.xy) * u_probe_resolution;
    ivec2 iuv = global_iuv + local_iuv;
    int layer = probe_coord.z;

    vec2 atlas_uv = uv_to_atlas_uv(uv, vec2(probe_coord.xy), vec2(u_probe_counts.xy));
    moments = texture(u_probe_depths_tex, vec3(atlas_uv, layer)).xy;
    indirect = texture(u_probe_colors_tex, vec3(atlas_uv, layer)).rgb;
    // moments = imageLoad(u_probe_depths, ivec3(iuv, layer)).xy;
    // indirect = imageLoad(u_probe_colors, ivec3(iuv, layer)).rgb;
}

vec3 get_indirect(Probe probe, vec3 n)
{
    return probe.indirect;
}

float compute_probe_visibility(vec2 depth_moments, vec3 probe_wp, vec3 wp, vec3 normal)
{
    float surface_to_probe_dist = distance(wp, probe_wp);

    float depth_moment = depth_moments.x;
    float depth_moment_sq = depth_moments.y;

    float depth_variance = max(0.001f, get_variance(depth_moment, depth_moment_sq));
            
    float visibility_certainty = depth_variance / (depth_variance + pow(depth_moment - surface_to_probe_dist, 2.f));
    float visibility_weight = surface_to_probe_dist > depth_moment ? visibility_certainty : 1.f;
    return visibility_weight;
}

vec3 sample_indirect_light(vec3 wp, vec3 normal)
{
    ivec3 probe_coord00 = coord_from_world(wp, u_probe_spacing);
    if (all(lessThan(probe_coord00, ivec3(15))))
    {
        vec3 probe_colors[8];
        float probe_weights[8];
        float probe_weights_sum = 0.f;

        vec3 f = fract(wp / u_probe_spacing);
        for (int i = 0; i < 8; i++)
        {
            ivec3 offset_coord = ivec3(i % 2, (i / 2) % 2, i/4);
            ivec3 probe_coord = probe_coord00 + offset_coord;
            uint probe_i = flatten_index(probe_coord, 16);
            Probe probe = probes.probes[probe_i];

            vec2 moments;
            read_probe_data(probe_coord, normal, moments, probe_colors[i]);
            vec3 corner = vec3(offset_coord);
            vec3 spatial_weights = mix(vec3(1.f) - f, f, corner);
            float spatial_weight = spatial_weights.x * spatial_weights.y * spatial_weights.z;
            
            vec3 probe_wp = vec3(probe_coord) * u_probe_spacing;
            float visibility_weight = compute_probe_visibility(moments, probe_wp, wp, normal);

            float combined_weight = visibility_weight * spatial_weight;

            probe_weights[i] = combined_weight;
            probe_weights_sum += combined_weight;
        }

        if (probe_weights_sum <= 0.0001f)
            return vec3(0.f);
        
        vec3 indirect_light = vec3(0);
        // normalization and accumulation
        for(int i = 0; i < 8; i++)
        {
            probe_weights[i] /= probe_weights_sum;
            indirect_light += probe_colors[i] * probe_weights[i];
        }
    
        return indirect_light;
    }
    return vec3(0.f);
}

float sample_shadow_factor(vec3 wp)
{
    return 1.f;
}

vec3 sun_dir()
{
    return normalize(vec3(1,-1,1));
}

vec3 sample_direct_light(vec3 wp, vec3 normal)
{
    vec3 sun_color = vec3(200, 182, 150)/255.f;
    float sun_intensity = 2.f;
    float n_dot_l = max(dot(normal, -sun_dir()), 0.f);

    return sun_intensity * sun_color * n_dot_l * sample_shadow_factor(wp);
}

vec3 calculate_brdf(vec3 L, vec3 V, vec3 N, vec3 albedo, float shininess)
{
    float N_dot_L = dot(N, L);
    vec3 H = normalize(L + V);

    vec3 diffuse = albedo / 3.14159f;
    vec3 specular_color = vec3(1.f);
    float spec = (shininess + 2.0) / (2.0 * 3.14159265)
           * pow(max(dot(N, H), 0.0), shininess);

    vec3 specular = vec3(spec);
    vec3 brdf = diffuse + specular;
    return brdf;
}


vec3 calculate_incoming_light(ivec2 uvi)
{
    float voxel_size = 64.f / pow(4.f, 4.f);

    vec3 ro;
    vec3 rd;
    create_ray(uvi, ro, rd);

    vec3 normal = imageLoad(u_normal, uvi).xyz;
    float depth = imageLoad(u_depth, uvi).x;
    vec3 albedo = imageLoad(u_albedo, uvi).rgb;

    if (depth > -0.5f)
    {
        vec3 hit_p = ro + rd * depth;
        vec3 quantized_hit_p = floor(hit_p / voxel_size) * voxel_size;
        
        vec3 L = -sun_dir();
        vec3 V = -rd;
        vec3 brdf = calculate_brdf(L, V, normal, albedo, 0.f);
        
        vec3 indirect_light = sample_indirect_light(quantized_hit_p, normal);
        vec3 direct_light = sample_direct_light(quantized_hit_p, normal) * brdf;
        
        vec3 reflected_light = indirect_light * (albedo / 3.14159) + direct_light;
        return reflected_light;
    }
    return vec3(0);
}

vec3 sample_skybox(vec3 rd)
{
    float t = clamp(rd.y * 0.5 + 0.5, 0.0, 1.0);

    vec3 horizon_color = vec3(1.0, 0.55, 0.2);
    vec3 zenith_color = vec3(0.25, 0.5, 0.9);
    vec3 sky = mix(horizon_color, zenith_color, t);

    vec3 sun_color = vec3(1.0, 0.85, 0.55) * 10.0;
    float sun = smoothstep(0.9995, 0.9998, dot(rd, -sun_dir()));

    return sky + sun_color * sun;
}

vec3 hash_u1f3(uint v)
{
    vec3 c;
    c.x = v * 14519518 + 19519521;
    c.y = v * 1565851562 + 512156251;
    c.z = v * 495266251 + 154621665;
    return fract(c / 256.f);
}

void main()
{
    ivec2 uvi = screen_coords();

    if (any(greaterThanEqual(uvi, imageSize(u_final))))
        return;

    vec2 uv = vec2(uvi) / vec2(imageSize(u_final));
    if (u_display_texture == DISPLAY_ALBEDO)
    {
        vec4 albedo = imageLoad(u_albedo, uvi);
        imageStore(u_final, uvi, albedo);
    }
    if (u_display_texture == DISPLAY_DEPTH)
    {
        vec4 depth = imageLoad(u_depth, uvi);
        depth.x *= u_brightness;
        imageStore(u_final, uvi, depth);
    }
    if (u_display_texture == DISPLAY_ITERATIONS)
    {
        vec4 debug = texelFetch(u_debug_texture, uvi, 0);
        imageStore(u_final, uvi, vec4(debug.r * u_brightness, 0,0,1));
    }
    if (u_display_texture == DISPLAY_NORMAL)
    {
        vec3 normal = imageLoad(u_normal, uvi).rgb;
        imageStore(u_final, uvi, vec4(normal * 0.5f + 0.5f, 1.f));
    }
    if (u_display_texture == DISPLAY_SUBDIV_DEPTH)
    {
        float depth = imageLoad(u_normal, uvi).a;
        imageStore(u_final, uvi, vec4(vec3(depth), 1.f));
    }
    if (u_display_texture == DISPLAY_INDIRECT)
    {
        float voxel_size = 64.f / pow(4.f, 4.f);
        float depth = imageLoad(u_depth, uvi).r;

        vec3 ro;
        vec3 rd;
        create_ray(uvi, ro, rd);
        vec3 hit_p = ro + rd * depth;
        vec3 quantized_hit_p = floor(hit_p / voxel_size) * voxel_size;
        vec3 normal = imageLoad(u_normal, uvi).xyz;

        vec3 indirect_light = sample_indirect_light(quantized_hit_p, normal);
        
        imageStore(u_final, uvi, vec4(indirect_light, 1.f));
    }
    if (u_display_texture == DISPLAY_FINAL)
    {
        float depth = imageLoad(u_depth, uvi).r;
        if (depth < 0.f)
        {
            vec3 ro, rd;
            create_ray(uvi, ro, rd);
            vec3 sky_color = sample_skybox(rd);
            imageStore(u_final, uvi, vec4(sky_color, 1.f));
            return;
        }
        float ao = texture(u_ao, uv).r;
        vec3 incoming_light = calculate_incoming_light(uvi);
        imageStore(u_final, uvi, vec4(incoming_light * ao, 1.f));
    }
    if (u_display_texture == DISPLAY_PROBE_DEPTH)
    {
        vec3 ro;
        vec3 rd;
        create_ray(uvi, ro, rd);
        //vec2 moments = sample_depth_moments(ro, rd);
        ivec3 probe_coord = clamp(coord_from_world(ro, u_probe_spacing), ivec3(0), ivec3(15));

        vec2 moments;
        vec3 indirect;
        read_probe_data(probe_coord, rd, moments, indirect);
        imageStore(u_final, uvi, vec4(moments * u_brightness * vec2(1, 0), 0.f, 1.f));
    }
    if (u_display_texture == DISPLAY_AO)
    {
        float ao = texture(u_ao, uv).r;
        imageStore(u_final, uvi, vec4(vec3(ao), 1.f));
    }
    if (u_display_texture == DISPLAY_PROBE_COLOR)
    {   
        vec3 ro;
        vec3 rd;
        create_ray(uvi, ro, rd);
        //vec2 moments = sample_depth_moments(ro, rd);
        ivec3 probe_coord = clamp(coord_from_world(ro, u_probe_spacing), ivec3(0), ivec3(15));

        vec3 indirect = sample_indirect_light(ro, rd);
        imageStore(u_final, uvi, vec4(indirect, 1.f));
    }
}